<Project Sdk="Godot.NET.Sdk/4.5.1">
    <PropertyGroup>
        <!-- 基础框架 -->
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <LangVersion>13.0</LangVersion>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- ============================================================
             环境路径（换机器时只改这三行，或用 -p: 命令行覆盖）
             ============================================================ -->
        <Sts2Dir Condition="'$(Sts2Dir)' == ''">E:/SteamLibrary/steamapps/common/Slay the Spire 2</Sts2Dir>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Dir)/data_sts2_windows_x86_64</Sts2DataDir>
        <GodotPath Condition="'$(GodotPath)' == ''">E:/SLJT2/anti/GODOT/Godot_v4.5.1-stable_mono_win64.exe</GodotPath>

        <!-- 主模组（CuteSakikoMod）工程目录：本工程与它并列放在 RiderProjects\ 下。
             若你的目录结构不同，用 -p:CuteSakikoModDir=... 覆盖。 -->
        <CuteSakikoModDir Condition="'$(CuteSakikoModDir)' == ''">$(MSBuildThisFileDirectory)..\CuteSakikoMod</CuteSakikoModDir>

        <!-- 主模组 DLL 引用的查找顺序（第一个命中的生效）：
             ① 命令行 -p:CuteSakikoModDll=... 显式指定
             ② 游戏 mods 目录（手动安装的正式版）
             ③ Steam 工坊订阅缓存（订阅方式安装时在这里，路径含工坊 item id）
             ④ 主模组工程的编译产物 bin/ 目录（本地刚编译过最新版）
             ⑤ 主模组工程根目录的 dll（最老，仅兜底）
             ⚠️ 主模组一旦上架工坊，游戏会从工坊拉取，:mods 目录下就没有了，
                所以要查 ③ 和 ④，否则会误用根目录里遗留的旧 dll（2026-10-29 踩坑）。 -->
        <CuteSakikoModDll Condition="'$(CuteSakikoModDll)' == '' AND Exists('$(Sts2Dir)/mods/CuteSakikoMod/CuteSakikoMod.dll')">$(Sts2Dir)/mods/CuteSakikoMod/CuteSakikoMod.dll</CuteSakikoModDll>
        <SteamWorkshopModDir Condition="'$(SteamWorkshopModDir)' == ''">E:/SteamLibrary/steamapps/workshop/content/2868840/3747559888</SteamWorkshopModDir>
        <CuteSakikoModDll Condition="'$(CuteSakikoModDll)' == '' AND Exists('$(SteamWorkshopModDir)/CuteSakikoMod.dll')">$(SteamWorkshopModDir)/CuteSakikoMod.dll</CuteSakikoModDll>
        <CuteSakikoModDll Condition="'$(CuteSakikoModDll)' == '' AND Exists('$(CuteSakikoModDir)/bin/Debug/CuteSakikoMod.dll')">$(CuteSakikoModDir)/bin/Debug/CuteSakikoMod.dll</CuteSakikoModDll>
        <CuteSakikoModDll Condition="'$(CuteSakikoModDll)' == ''">$(CuteSakikoModDir)/CuteSakikoMod.dll</CuteSakikoModDll>

        <!-- 模组输出目录 -->
        <ModsPath>$(Sts2Dir)/mods/</ModsPath>
    </PropertyGroup>

    <!-- ★ 按游戏版本构建变体：0.111.0 / 0.113.0（0.107.1 预留）。
         版本可用 -p:Sts2GameVersion=... 显式指定，否则读游戏 release_info.json；
         HextechRunes 与 RitsuLib 的引用也跟着切。 -->
    <PropertyGroup>
        <_Sts2GameVersion Condition="'$(Sts2GameVersion)' != ''">$(Sts2GameVersion)</_Sts2GameVersion>
        <_Sts2ReleaseInfoPath>$(Sts2Dir)/release_info.json</_Sts2ReleaseInfoPath>
        <_Sts2ReleaseInfo Condition="Exists('$(_Sts2ReleaseInfoPath)')">$([System.IO.File]::ReadAllText('$(_Sts2ReleaseInfoPath)'))</_Sts2ReleaseInfo>
        <_Sts2GameVersion Condition="'$(_Sts2GameVersion)' == '' and '$(_Sts2ReleaseInfo)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(_Sts2ReleaseInfo), '"version"\s*:\s*"v?([0-9]+\.[0-9]+\.[0-9]+)"').Groups[1].Value)</_Sts2GameVersion>
        <HextechRefTarget Condition="'$(HextechRefTarget)' == '' and '$(_Sts2GameVersion)' != '' and $([MSBuild]::VersionGreaterThanOrEquals('$(_Sts2GameVersion)', '0.113.0'))">0.113.0</HextechRefTarget>
        <HextechRefTarget Condition="'$(HextechRefTarget)' == ''">0.111.0</HextechRefTarget>
        <RitsuLibPackageId Condition="'$(RitsuLibPackageId)' == ''">STS2.RitsuLib</RitsuLibPackageId>
        <RitsuLibPackageVersion Condition="'$(RitsuLibPackageVersion)' == ''">0.6.11</RitsuLibPackageVersion>
        <RitsuLibRuntimeDll Condition="'$(RitsuLibRuntimeDll)' == ''">$(CuteSakikoModDir)\packages\sts2.ritsulib\0.6.11\lib\net9.0\STS2-RitsuLib.Runtime.dll</RitsuLibRuntimeDll>
    </PropertyGroup>

    <Target Name="LogHextechRefTarget" BeforeTargets="CoreCompile">
        <Message Text="[CuteSakikoModHex] Game '$(_Sts2GameVersion)' -&gt; HextechRunes $(HextechRefTarget) variant / $(RitsuLibPackageId) $(RitsuLibPackageVersion)" Importance="high" />
    </Target>

    <!-- 0.108 起伤害管线带 CardPlay 参数（0.107 只有 FromCard(CardModel)）。 -->
    <PropertyGroup Condition="'$(_Sts2GameVersion)' != '' and $([MSBuild]::VersionGreaterThanOrEquals('$(_Sts2GameVersion)', '0.108.0'))">
        <DefineConstants>$(DefineConstants);CSK_GAME_108_OR_NEWER</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <!-- 加载器工程在 loader/ 下，不能编进变体程序集。 -->
        <Compile Remove="loader/**" />
        <EmbeddedResource Remove="loader/**" />
        <None Remove="loader/**" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="CuteSakikoMod">
          <HintPath>$(CuteSakikoModDll)</HintPath>
          <Private>false</Private>
        </Reference>
        <Reference Include="HextechRunes">
          <HintPath>$(CuteSakikoModDir)\packages\sts2mod.hex\lib\$(HextechRefTarget)\HextechRunes.dll</HintPath>
          <Private>false</Private>
        </Reference>
        <Reference Include="STS2-RitsuLib.Runtime">
          <HintPath>$(RitsuLibRuntimeDll)</HintPath>
          <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

