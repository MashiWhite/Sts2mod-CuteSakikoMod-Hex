    <ItemGroup>
      <!-- RitsuLib 走 NuGet；STS2-RitsuLib.Runtime 的显式引用已在顶部 ItemGroup 里
           （用 $(CuteSakikoModDir) 解析，换机器只需改一个属性） -->
      <PackageReference Include="STS2.RitsuLib" Version="0.6.10" />
    </ItemGroup>

    <!-- 自动复制 dll 和 json（保留你的原目标，但为了顺序稍作调整） -->
    <Target Name="CopyMod" AfterTargets="Build">
        <Message Text="Copying mod DLL and JSON to $(ModsPath)" Importance="high" />
        <MakeDir Directories="$(ModsPath)$(MSBuildProjectName)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(MSBuildProjectName)" />
        <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(ModsPath)$(MSBuildProjectName)" />
    </Target>

    <Target Name="BuildPck" AfterTargets="Build"
            Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <Message Text="Exporting Godot .pck to mods folder (from Build)" Importance="high"/>
        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;CuteSakikoModHex.pck&quot; &quot;$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck&quot;"
              WorkingDirectory="$(MSBuildProjectDirectory)"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
              ContinueOnError="WarnAndContinue" />
    </Target>
